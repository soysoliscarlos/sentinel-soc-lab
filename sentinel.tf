variable "enable_sentinel_analytics" {
  description = "Creates the workbook, LAB-Pxx scheduled analytic rules, hunting queries, and automation rule correlating SOC-L2-Pxx marked activity. Requires Sentinel onboarding on the workspace."
  type        = bool
  default     = false
  nullable    = false
}

locals {
  # Each rule creates LAB-Pxx incidents from the SOC-L2 markers generated by Invoke-SocLabLogGeneration.ps1.
  # Configured with Medium/High severities to ensure direct visibility in Defender XDR (Priority Score >= 15)
  # and PT5M frequency for rapid evaluation after running the script.
  sentinel_rules = {
    P02 = {
      display_name    = "LAB-P02 - Windows Authentication Failures (Brute Force)"
      description     = "Multiple Event ID 4625 logon failures with nonexistent soc-l2-p02-* accounts generated by test P02."
      severity        = "High"
      tactics         = ["CredentialAccess"]
      query_frequency = "PT5M"
      query_period    = "PT30M"
      query           = <<-KQL
        SecurityEvent
        | where EventID == 4625 and TargetUserName startswith "soc-l2-p02"
        | summarize FailedAttempts = count() by Computer, TargetUserName, IpAddress, bin(TimeGenerated, 5m)
        | where FailedAttempts >= 2
      KQL
      entities = [
        { entity_type = "Account", mappings = [{ identifier = "Name", column_name = "TargetUserName" }] },
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
        { entity_type = "IP", mappings = [{ identifier = "Address", column_name = "IpAddress" }] },
      ]
    }
    P15 = {
      display_name    = "LAB-P15 - Anomalous AD Account and Group Management"
      description     = "Creation, modification, and deletion of disposable SOCp15/SOCg15 domain accounts and groups from test P15."
      severity        = "High"
      tactics         = ["Persistence", "PrivilegeEscalation"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        SecurityEvent
        | where EventID in (4720, 4722, 4724, 4725, 4726, 4727, 4728, 4729, 4730, 4732, 4733, 4738)
        | where TargetUserName startswith "SOCp15" or TargetUserName startswith "SOCg15" or MemberName has "SOCp15"
        | project TimeGenerated, Computer, EventID, Activity, SubjectUserName, TargetUserName, MemberName
      KQL
      entities = [
        { entity_type = "Account", mappings = [{ identifier = "Name", column_name = "TargetUserName" }] },
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
      ]
    }
    P03 = {
      display_name    = "LAB-P03 - Suspicious Process Execution on Windows"
      description     = "Event ID 4688 process creation events containing the SOC-L2-P03 command-line marker from test P03."
      severity        = "Medium"
      tactics         = ["Execution"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        SecurityEvent
        | where EventID == 4688 and CommandLine has "SOC-L2-P03"
        | project TimeGenerated, Computer, SubjectUserName, NewProcessName, CommandLine, ParentProcessName
      KQL
      entities = [
        { entity_type = "Account", mappings = [{ identifier = "Name", column_name = "SubjectUserName" }] },
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
      ]
    }
    P04B = {
      display_name    = "LAB-P04B - Linux SSH and su Brute Force"
      description     = "Failed SSH and su authentication attempts with nonexistent socp04* users from test P04B."
      severity        = "High"
      tactics         = ["CredentialAccess"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        Syslog
        | where ProcessName in ("sshd", "su") and SyslogMessage has "socp04"
        | project TimeGenerated, Computer, Facility, ProcessName, SyslogMessage
      KQL
      entities = [
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
      ]
    }
    P05 = {
      display_name    = "LAB-P05 - Web Scanning and Reconnaissance on App Service"
      description     = "Suspicious path-traversal/injection probe paths and HTTP methods using the SOC-L2-Lab User-Agent from test P05."
      severity        = "Medium"
      tactics         = ["Discovery", "InitialAccess"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        AppServiceHTTPLogs
        | where UserAgent startswith "SOC-L2-Lab" and ScStatus >= 400
        | project TimeGenerated, CIp, CsMethod, CsUriStem, ScStatus
      KQL
      entities = [
        { entity_type = "IP", mappings = [{ identifier = "Address", column_name = "CIp" }] },
      ]
    }
    P07 = {
      display_name    = "LAB-P07 - Unauthorized or Denied Access in Key Vault"
      description     = "Failed read of nonexistent secret soc-l2-p07 in Key Vault generated by test P07."
      severity        = "Medium"
      tactics         = ["Discovery", "CredentialAccess"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        AZKVAuditLogs
        | where OperationName has "Secret" and RequestUri has "soc-l2-p07"
        | where ResultSignature != "OK" or toint(HttpStatusCode) >= 400
        | project TimeGenerated, CallerIpAddress, OperationName, ResultSignature, HttpStatusCode, RequestUri
      KQL
      entities = [
        { entity_type = "IP", mappings = [{ identifier = "Address", column_name = "CallerIpAddress" }] },
      ]
    }
    P08 = {
      display_name    = "LAB-P08 - Kubernetes Administrative Modifications"
      description     = "Object creation, update, or deletion in namespace soc-l2-p08 on AKS from test P08."
      severity        = "Medium"
      tactics         = ["Persistence", "Execution"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        AKSAuditAdmin
        | where RequestUri has "soc-l2-p08" and Verb in ("create", "update", "delete")
        | project TimeGenerated, Verb, RequestUri, StatusCode = tostring(parse_json(tostring(ResponseStatus)).code), Username = tostring(parse_json(tostring(User)).username)
      KQL
      entities        = []
    }
    P09 = {
      display_name    = "LAB-P09 - Suspicious ARM Tag Modification"
      description     = "Unauthorized modification of SOCPrueba tags on Azure resources logged in AzureActivity."
      severity        = "Medium"
      tactics         = ["Impact"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        AzureActivity
        | where OperationNameValue startswith "MICROSOFT.RESOURCES/TAGS/"
        | where ActivityStatusValue in ("Success", "Succeeded", "Accepted")
        | where Properties has "SOCPrueba" or Properties has "SOC-L2-P09"
        | project TimeGenerated, Caller, CallerIpAddress, OperationNameValue, ActivityStatusValue, _ResourceId
      KQL
      entities = [
        { entity_type = "Account", mappings = [{ identifier = "Name", column_name = "Caller" }] },
        { entity_type = "IP", mappings = [{ identifier = "Address", column_name = "CallerIpAddress" }] },
      ]
    }
    P10 = {
      display_name    = "LAB-P10 - Warning Event in AKS Pods"
      description     = "Kubernetes Warning events generated by anomalous test pod deployments on AKS."
      severity        = "Medium"
      tactics         = ["Execution"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        KubeEvents
        | where Namespace startswith "soc-l2-p08" and KubeEventType == "Warning"
        | project TimeGenerated, Computer, Namespace, Name, ObjectKind, Reason, Message
      KQL
      entities = [
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
      ]
    }
    P11 = {
      display_name    = "LAB-P11 - Anomalous HTTP Request on Apache Server"
      description     = "Marked HTTP requests with suspicious URI paths recorded by Apache in Syslog local6."
      severity        = "Medium"
      tactics         = ["InitialAccess", "Discovery"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        Syslog
        | where Facility == "local6" and SyslogMessage has "SOC-L2-P11"
        | project TimeGenerated, Computer, Facility, ProcessName, SyslogMessage
      KQL
      entities = [
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
      ]
    }
    P12 = {
      display_name    = "LAB-P12 - Suspicious HTTP Request on IIS Server"
      description     = "Marked web probe or anomalous access recorded in Windows Server W3CIISLog."
      severity        = "Medium"
      tactics         = ["InitialAccess", "Discovery"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        W3CIISLog
        | where csUriStem has "SOC-L2-P12"
        | project TimeGenerated, Computer, sSiteName, csMethod, csUriStem, scStatus, cIP, csUserAgent
      KQL
      entities = [
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
        { entity_type = "IP", mappings = [{ identifier = "Address", column_name = "cIP" }] },
      ]
    }
    P13 = {
      display_name    = "LAB-P13 - PostgreSQL Database Authentication Failure"
      description     = "Failed PostgreSQL connection or authentication attempts with invalid user recorded in Syslog local5."
      severity        = "Medium"
      tactics         = ["CredentialAccess"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        Syslog
        | where Facility == "local5" and SyslogMessage has "soc_l2_p13"
        | project TimeGenerated, Computer, ProcessName, SeverityLevel, SyslogMessage
      KQL
      entities = [
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
      ]
    }
    P14 = {
      display_name    = "LAB-P14 - Suspicious Event in Windows Application Log"
      description     = "Warning-level event recorded by source SOC-L2-Lab in the Windows Application log."
      severity        = "Medium"
      tactics         = ["DefenseEvasion"]
      query_frequency = "PT5M"
      query_period    = "PT15M"
      query           = <<-KQL
        Event
        | where Source == "SOC-L2-Lab" and RenderedDescription has "SOC-L2-P14"
        | project TimeGenerated, Computer, EventLog, EventLevelName, EventID, RenderedDescription
      KQL
      entities = [
        { entity_type = "Host", mappings = [{ identifier = "HostName", column_name = "Computer" }] },
      ]
    }
  }
}

resource "random_uuid" "sentinel_rule" {
  for_each = var.enable_sentinel_analytics ? local.sentinel_rules : {}
}

resource "random_uuid" "sentinel_workbook" {
  count = var.enable_sentinel_analytics ? 1 : 0
}

resource "random_uuid" "sentinel_automation" {
  count = var.enable_sentinel_analytics ? 1 : 0
}

resource "azurerm_sentinel_alert_rule_scheduled" "lab" {
  for_each = var.enable_sentinel_analytics ? local.sentinel_rules : {}

  name                       = random_uuid.sentinel_rule[each.key].result
  log_analytics_workspace_id = azurerm_log_analytics_workspace.soc.id
  display_name               = each.value.display_name
  description                = each.value.description
  severity                   = each.value.severity
  tactics                    = each.value.tactics
  enabled                    = true
  query                      = each.value.query
  query_frequency            = each.value.query_frequency
  query_period               = each.value.query_period
  trigger_operator           = "GreaterThan"
  trigger_threshold          = 0
  suppression_enabled        = false

  event_grouping {
    aggregation_method = "AlertPerResult"
  }

  incident {
    create_incident_enabled = true

    grouping {
      enabled                 = true
      entity_matching_method  = "AllEntities"
      lookback_duration       = "PT1H"
      reopen_closed_incidents = false
    }
  }

  dynamic "entity_mapping" {
    for_each = each.value.entities
    content {
      entity_type = entity_mapping.value.entity_type

      dynamic "field_mapping" {
        for_each = entity_mapping.value.mappings
        content {
          identifier  = field_mapping.value.identifier
          column_name = field_mapping.value.column_name
        }
      }
    }
  }

  depends_on = [azurerm_sentinel_log_analytics_workspace_onboarding.soc]
}

resource "azurerm_application_insights_workbook" "soc" {
  count = var.enable_sentinel_analytics ? 1 : 0

  name                = random_uuid.sentinel_workbook[0].result
  resource_group_name = azurerm_resource_group.lab.name
  location            = azurerm_resource_group.lab.location
  display_name        = "SOC L2 Lab - Generated Security Events"
  source_id           = lower(azurerm_log_analytics_workspace.soc.id)
  category            = "sentinel"
  data_json           = file("${path.module}/files/soc-workbook.json")
  tags                = local.tags
}

resource "azurerm_sentinel_automation_rule" "lab" {
  count = var.enable_sentinel_analytics ? 1 : 0

  name                       = random_uuid.sentinel_automation[0].result
  log_analytics_workspace_id = azurerm_log_analytics_workspace.soc.id
  display_name               = "LAB - Tag and Enrich Workshop Incidents"
  order                      = 1
  enabled                    = true
  triggers_on                = "Incidents"
  triggers_when              = "Created"

  condition_json = jsonencode([
    {
      conditionType = "Property"
      conditionProperties = {
        propertyName   = "IncidentTitle"
        operator       = "Contains"
        propertyValues = ["LAB-"]
      }
    }
  ])

  action_incident {
    order  = 1
    labels = ["SOC-L2-Lab"]
  }

  dynamic "action_playbook" {
    for_each = var.enable_sentinel_playbooks ? local.sentinel_playbook_actions : {}
    content {
      order        = action_playbook.value.order
      logic_app_id = jsondecode(azurerm_resource_group_template_deployment.playbook[action_playbook.key].output_content).logicAppResourceId.value
      tenant_id    = data.azurerm_client_config.current.tenant_id
    }
  }

  depends_on = [azurerm_sentinel_alert_rule_scheduled.lab]
}

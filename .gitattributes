# Auto-detect text files and perform LF normalization on checkin
* text=auto

# Code and configuration files requiring LF line endings
*.tf text eol=lf
*.tfvars text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary

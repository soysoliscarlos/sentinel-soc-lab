# ==============================================================================
# Configuration Variables for the Azure SOC L2 Cyber Range
# Copy this file to 'terraform.tfvars' and fill in your values before running 'terraform apply'.
# ==============================================================================

# Target Azure Subscription ID where resources will be deployed (required).
subscription_id = "00000000-0000-0000-0000-000000000000"

# Globally unique prefix used to name all lab resources (e.g., "soc-l2").
name_prefix = "soc-l2"

# Target Azure region for deployment (e.g., "eastus2", "westeurope").
location = "eastus2"

# Approved public IPv4 CIDR for SSH, RDP, AKS API, and Key Vault (/24 to /32).
# Check your current public IPv4 address via https://api.ipify.org
admin_source_cidr = "203.0.113.10/32"

# ------------------------------------------------------------------------------
# Optional Infrastructure Component Toggles (true/false)
# ------------------------------------------------------------------------------
create_app_service = true
create_linux_vm    = true
create_windows_vm  = true
create_aks         = true

# ------------------------------------------------------------------------------
# Guest Configuration and Service Provisioning with Ansible
# Requires both create_linux_vm = true and create_windows_vm = true.
# Installs IIS and an AD DS forest on Windows, plus Apache and PostgreSQL on Linux.
# ------------------------------------------------------------------------------
enable_ansible = true

# DNS FQDN and NetBIOS name for the new Active Directory (AD DS) forest on Windows
ad_domain_name    = "lab.example.test"
ad_domain_netbios = "LAB"

# ------------------------------------------------------------------------------
# Benign Marked Activity Generation (SOC-L2-Pxx)
# Runs scripts/Invoke-SocLabLogGeneration.ps1 at the end of apply to populate Sentinel.
# Changing log_generation_trigger re-runs log generation on a subsequent apply.
# ------------------------------------------------------------------------------
enable_log_generation = true
# log_generation_trigger = "initial"
# log_generation_tests   = ["All"]

# ------------------------------------------------------------------------------
# Detection, Visualization, and Automation Content in Microsoft Sentinel
# ------------------------------------------------------------------------------
# LAB-Pxx scheduled analytic rules, hunting queries, automation rule, and workbook
enable_sentinel_analytics = true

# Logic App playbooks for automated incident enrichment comments and triage labels
enable_sentinel_playbooks = true

# Azure Machine Learning workspace and Compute Instance for Jupyter hunting notebooks
# NOTE: The compute instance incurs hourly charges while running.
enable_sentinel_notebooks = true

# ------------------------------------------------------------------------------
# Microsoft Defender for Servers & Defender for Endpoint (Device Inventory)
# ------------------------------------------------------------------------------
# Enables Defender for Servers (Plan 1) and deploys MDE extensions on Windows and Linux
# so VMs onboard directly into Defender XDR Device Inventory (Assets -> Devices).
enable_defender_for_servers = true
defender_servers_subplan    = "P1"

# ------------------------------------------------------------------------------
# Virtual Machine Sizes and OS Disk Specifications
# ------------------------------------------------------------------------------
linux_vm_size     = "Standard_D2s_v6"
linux_image_sku   = "22_04-lts-gen2"
linux_os_disk_sku = "Standard_LRS"

windows_vm_size     = "Standard_D2s_v6"
windows_image_sku   = "2022-datacenter-azure-edition"
windows_os_disk_sku = "Standard_LRS"

# ------------------------------------------------------------------------------
# Azure Kubernetes Service (AKS) Specifications
# ------------------------------------------------------------------------------
aks_sku_tier          = "Free"
aks_node_count        = 2
aks_node_vm_size      = "Standard_D4s_v6"
aks_os_sku            = "Ubuntu"
aks_load_balancer_sku = "standard"

# ------------------------------------------------------------------------------
# Supporting Services and SKU Tiers
# ------------------------------------------------------------------------------
app_service_sku   = "B1"
key_vault_sku     = "standard"
log_workspace_sku = "PerGB2018"
public_ip_sku     = "Standard"
